{%- set cur = page.url | replace(".html","") -%}
<!doctype html>
<html lang="da">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set sidetitel -%}{% if title %}{{ title }} · {{ site.undertitel }}{% else %}{{ site.seo_titel or site.navn }}{% endif %}{%- endset -%}
{%- set beskrivelse = description or summary or site.seo_beskrivelse or site.footer_tekst -%}
{%- set kanonisk = site.url + page.url -%}
{%- set delebillede = site.url + "/files/rca-deling.png" -%}
<title>{{ sidetitel }}</title>
<meta name="description" content="{{ beskrivelse }}">
{% if noindex %}<meta name="robots" content="noindex, follow">{% else %}<link rel="canonical" href="{{ kanonisk }}">{% endif %}
<meta property="og:type" content="{% if page.url.startsWith('/nyheder/') and page.url != '/nyheder/' %}article{% else %}website{% endif %}">
<meta property="og:site_name" content="{{ site.navn }}">
<meta property="og:locale" content="da_DK">
<meta property="og:title" content="{{ title or site.seo_titel or site.navn }}">
<meta property="og:description" content="{{ beskrivelse }}">
<meta property="og:url" content="{{ kanonisk }}">
<meta property="og:image" content="{{ delebillede }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Ressourcecenter for Adopterede – Viden · Fællesskab · Rettigheder">
<meta name="twitter:card" content="summary_large_image">
{%- set org = {
  "@type": "NGO", "@id": site.url + "/#organisation",
  "name": "Ressourcecenter for Adopterede", "alternateName": ["RCA", "Ressourcecenter for Adopterede (RCA)"],
  "url": site.url + "/", "logo": site.url + "/files/signatur/rca-logo.png", "image": delebillede,
  "description": site.seo_beskrivelse or site.footer_tekst, "email": site.email,
  "foundingDate": site.stiftet, "areaServed": {"@type": "Country", "name": "Danmark"},
  "knowsAbout": ["Adoption", "Transnational adoption", "Adopteredes rettigheder", "Søgning efter biologisk ophav", "Adopteredes psykiske helbred"],
  "sameAs": [site.linkedin]
} -%}
{%- set graf = [org, {
  "@type": "WebSite", "@id": site.url + "/#website", "url": site.url + "/", "name": site.navn, "inLanguage": "da-DK",
  "publisher": {"@id": site.url + "/#organisation"},
  "potentialAction": {"@type": "SearchAction", "target": site.url + "/soeg/?q={search_term_string}", "query-input": "required name=search_term_string"}
}] -%}
{%- if page.url.startsWith("/viden/") and page.url != "/viden/" and not noindex -%}
{%- set opd = content | opdateret_iso -%}
{%- set _x = graf.push({
  "@type": "Article", "@id": kanonisk + "#artikel", "headline": title, "description": beskrivelse, "url": kanonisk,
  "inLanguage": "da-DK", "isAccessibleForFree": true, "image": delebillede,
  "author": {"@id": site.url + "/#organisation"}, "publisher": {"@id": site.url + "/#organisation"},
  "dateModified": opd or none, "mainEntityOfPage": kanonisk, "isPartOf": {"@id": site.url + "/#website"}
}) -%}
{%- set _x = graf.push({"@type": "BreadcrumbList", "itemListElement": [
  {"@type": "ListItem", "position": 1, "name": "Forside", "item": site.url + "/"},
  {"@type": "ListItem", "position": 2, "name": "Viden", "item": site.url + "/viden/"},
  {"@type": "ListItem", "position": 3, "name": title, "item": kanonisk}]}) -%}
{%- elif page.url.startsWith("/nyheder/") and page.url != "/nyheder/" -%}
{%- set _x = graf.push({
  "@type": "NewsArticle", "@id": kanonisk + "#nyhed", "headline": title, "description": beskrivelse, "url": kanonisk,
  "inLanguage": "da-DK", "image": delebillede, "datePublished": page.date | isodato,
  "author": {"@id": site.url + "/#organisation"}, "publisher": {"@id": site.url + "/#organisation"}, "mainEntityOfPage": kanonisk
}) -%}
{%- endif %}
{% if not noindex %}<script type="application/ld+json">{{ {"@context": "https://schema.org", "@graph": graf} | json | safe }}</script>{% endif %}
<meta name="theme-color" content="#f7f3ec">
<link rel="stylesheet" href="/styles.css">
<link rel="alternate" type="application/rss+xml" title="Nyheder fra {{ site.navn }}" href="/feed.xml">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='32' fill='%2317424d'/%3E%3Ctext x='32' y='41' font-family='Georgia,serif' font-size='22' font-weight='700' fill='%23f7f3ec' text-anchor='middle'%3ERCA%3C/text%3E%3C/svg%3E">
</head>
<body>
<a class="skip" href="#indhold">Spring til indhold</a>
{% include "icons.html" %}
<header class="site">
  <div class="wrap bar">
    <a class="logo" href="/"><b>{{ site.kort_navn }}</b><span>{{ site.undertitel }}</span></a>
    <button class="menu-btn" aria-expanded="false" aria-controls="hovedmenu">Menu</button>
    <nav class="main" id="hovedmenu" aria-label="Hovedmenu">
      <ul>
{%- for m in site.menu %}
        {%- set active = (m.link == "/" and cur == "/") or (m.link != "/" and (cur == m.link + "/" or cur.startsWith(m.link + "/"))) %}
        <li><a href="{{ m.link }}"{% if active %} aria-current="page"{% endif %}>{{ m.tekst }}</a></li>
{%- endfor %}
      </ul>
    </nav>
    <a class="soeg-link" href="/soeg/" aria-label="Søg på siden" title="Søg"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></a>
    {% if site.knap_tekst %}<a class="btn terra header-cta" href="{{ site.knap_link }}" style="padding:9px 16px;font-size:.92rem;margin-top:0">{{ site.knap_tekst }}</a>{% endif %}
  </div>
</header>

<main id="indhold"{% if soeg !== false %} data-pagefind-body{% endif %}>
{{ content | safe }}
</main>
{% if gf %}{% include "gf_mm.html" %}
<script src="/generalforsamling.js" defer></script>
<script src="/referat.js" defer></script>{% endif %}
<footer class="site">
  <div class="wrap foot">
    <div>
      <p style="font-family:var(--serif);font-size:1.3rem;font-weight:700;margin-bottom:.3em">{{ site.navn }}</p>
      <p>{{ site.footer_tekst }}</p>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a>{% if site.linkedin %} · <a href="{{ site.linkedin }}">LinkedIn</a>{% endif %}{% if site.facebook %} · <a href="{{ site.facebook }}">Facebook</a>{% endif %}</p>
    </div>
    <nav aria-label="Sidefod">
      <ul>
{%- for m in site.menu %}{% if m.link != "/" %}
        <li><a href="{{ m.link }}">{{ m.tekst }}</a></li>
{%- endif %}{% endfor %}
      </ul>
    </nav>
  </div>
  <div class="wrap copy">© 2026 {{ site.navn }}</div>
</footer>
<script src="/main.js"></script>
</body>
</html>
