---
layout: base.njk
permalink: /viden/
title: Viden om adoption
description: Guides og forskning om transnational adoption samlet ét sted – søg dit ophav, kend dine rettigheder, helbred og trivsel. Med kilder og tydelige kildetyper.
---
{% set v = viden %}
{% set antal = v.temaer | antal_kilder %}
{%- set ikoner = {
  "soeg": '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  "papir": '<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 13h7M9 17h5"/>',
  "hjerte": '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>',
  "puls": '<path d="M4 12h4l2-5 4 10 2-5h4"/>',
  "fly": '<path d="M2 16l20-8-6 12-3-5z"/><path d="M13 15 22 8"/>',
  "bog": '<path d="M4 5h6a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H4zM20 5h-6a3 3 0 0 0-3 3"/><path d="M20 5v13h-7"/>'
} -%}
<script>
  /* Gamle links som /viden/#psykisk-helbred sendes videre til temaets egen side */
  (function(){var h=decodeURIComponent(location.hash.slice(1)),ids=[{% for t in v.temaer %}{% if t.klar %}"{{ t.id }}",{% endif %}{% endfor %}];if(h&&ids.indexOf(h)>-1)location.replace("/viden/"+h+"/");})();
</script>
<div class="vh-band">
  <div class="wrap vh-hero">
    <h1><span class="vh-eyebrow">{{ v.overskrift }}</span>{{ v.behov_overskrift }}</h1>
    <p class="vh-intro">{{ v.behov_intro }}</p>
    <form class="vh-soeg" action="/soeg/" method="get" role="search">
      <label for="vq" class="sr-only">Søg i viden</label>
      <input id="vq" name="q" type="search" placeholder="Søg fx: aktindsigt, DNA, Korea, psykolog" autocomplete="off">
      <button type="submit">Søg</button>
    </form>
  </div>
  <div class="wrap vh-behov">
    <ul class="vh-kort">
      {% for b in v.behov %}<li><a href="{{ b.link }}">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">{{ ikoner[b.ikon] | safe }}</svg>
        <span><b>{{ b.titel }}</b><span>{{ b.tekst or (antal + " studier og rapporter, opdelt i " + (v.temaer | length) + " temaer") }}</span></span>
      </a></li>
      {% endfor %}
    </ul>
    {% if v.hjaelp_nu %}<p class="vh-hjaelp" role="note">{{ v.hjaelp_nu | replace("70 201 201", "<b>70 201 201</b>") | safe }}</p>{% endif %}
  </div>
</div>

<div class="vg-band">
  <div class="wrap">
    <p class="eyebrow">Trin for trin</p>
    <h2>{{ v.guides_overskrift }}</h2>
    <p class="vg-intro">{{ v.guides_intro }}</p>
    <ul class="vg-liste">
      {% for g in v.guides %}{% if (g.sektion or "guide") == "guide" %}<li><a href="{{ g.link }}">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3 8-8"/><path d="M20 12v7H4V5h11"/></svg>
        <span><b>{{ g.titel }}</b><span>{{ g.kort or g.tekst }}</span></span><span class="vg-pil" aria-hidden="true">→</span>
      </a></li>
      {% endif %}{% endfor %}
    </ul>
  </div>
</div>

<div class="vf-band" id="forskning">
  <div class="wrap">
    <p class="eyebrow">Viden med kilder</p>
    <h2>{{ v.forskning_overskrift }}</h2>
    <p class="vf-intro">{{ v.forskning_intro }}</p>
    <ul class="vf-liste">
      {% for t in v.temaer %}{% if t.klar %}<li><a href="/viden/{{ t.id }}/">
        <b>{{ t.titel }}</b><span>{{ t.kort }}</span>
        <span class="vf-meta"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5"/></svg>{{ (t | tema_kilder) | length }} kilder{% if t.opdateret %} · Opdateret {{ t.opdateret | dato }}{% endif %}</span>
      </a></li>
      {% else %}{% if t.titel %}<li class="vf-snart"><b>{{ t.titel }}</b><span>{{ t.kort }}</span><span class="vf-meta">Kommer snart</span></li>{% endif %}
      {% endif %}{% endfor %}
      {% for g in v.guides %}{% if g.sektion == "forskning" %}<li><a href="{{ g.link }}">
        <b>{{ g.titel }}</b><span>{{ g.kort or g.tekst }}</span>
        <span class="vf-meta"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>Tidslinje · Opdateres løbende</span>
      </a></li>
      {% endif %}{% endfor %}
    </ul>
    {% for g in v.guides %}{% if g.sektion == "laesning" %}<p class="vf-ekstra"><a href="{{ g.link }}">{{ g.titel }}</a> – {{ g.kort or g.tekst }}</p>{% endif %}{% endfor %}
  </div>
</div>

<div class="vm-band">
  <div class="wrap">
    <div class="vm-boks">
      <div>
        <h2>Sådan arbejder vi med viden</h2>
        <p>{{ v.metode_tekst }}</p>
        <p><a href="{{ v.kildetyper_link }}">Læs om vores metode og kildetyperne</a> · <a href="/viden/aendringslog/">Ændringslog</a></p>
        <p class="muted">Senest opdateret {{ byggedato | dato }}.</p>
      </div>
      <div class="vm-knapper">
        <a class="btn" href="/viden/bidrag/">Foreslå en kilde eller ret en fejl</a>
        <a class="btn ghost" href="/viden/print/"><svg><use href="#i-down"/></svg>Hent hele samlingen som PDF</a>
      </div>
    </div>
  </div>
</div>
