---
layout: base.njk
permalink: /viden/
title: Viden
description: Forskning og undersøgelser om transnational adoption, samlet af Ressourcecenter for Adopterede (RCA).
---
{% from "ikon.njk" import ikon %}
{% from "vidensstatus.njk" import vidensstatus %}
{% set v = viden %}
  <div class="page-head"><div class="wrap">
    <p class="eyebrow">{{ v.eyebrow }}</p>
    <h1>{{ v.overskrift }}</h1>
    <p class="lead" style="max-width:780px">{{ v.intro }}</p>
    <div class="btns"><a class="btn ghost" href="/viden/print/"><svg><use href="#i-down"/></svg>Hent hele samlingen som PDF</a></div>
    <p class="muted" style="font-size:.95rem;margin-top:12px">Samlingen opdateres løbende. Senest opdateret {{ byggedato | dato }}. Vi skaber den sammen med adopterede og fagfolk – <a href="/viden/bidrag/">bidrag med viden eller rettelser</a>, og læs <a href="/viden/saadan-arbejder-vi/">hvordan vi arbejder</a>.</p>
  </div></div>

  {% if v.guides %}<section>
    <div class="wrap">
      <h2>{{ v.guides_overskrift or "Praktiske guides" }}</h2>
      <div class="grid g2" style="margin-top:24px">
        {% for g in v.guides %}<a class="card news-card tema" href="{{ g.link }}">{{ ikon(g.ikon, g.farve) }}<h3>{{ g.titel }}</h3><p>{{ g.tekst }}</p><span class="tema-link">Læs guiden</span></a>
        {% endfor %}
      </div>
    </div>
  </section>{% endif %}

  <section>
    <div class="wrap">
      <h2>Temaer</h2>
      <div class="grid g2" style="margin-top:24px">
        {% for t in v.temaer %}{% if t.klar %}<a class="card news-card tema" href="#{{ t.id }}">{{ ikon(t.ikon, t.farve) }}<h3>{{ t.titel }}</h3><p>{{ t.kort }}</p><span class="tema-link">Læs mere</span></a>
        {% else %}<div class="card tema">{{ ikon(t.ikon, t.farve) }}<h3>{{ t.titel }}</h3><p class="muted">{{ t.kort }}</p><span class="soon">Kommer snart</span></div>
        {% endif %}{% endfor %}
      </div>
    </div>
  </section>

{% for t in v.temaer %}{% if t.klar %}
  <section id="{{ t.id }}" class="tema-sektion">
    <div class="wrap">
      <p class="eyebrow">Tema</p>
      <h2>{{ t.titel }}</h2>
      {% if t.stoette %}<p class="stoette" role="note"><b>Vær opmærksom:</b> {{ t.stoette }}</p>{% endif %}
      <div style="max-width:820px">{{ vidensstatus(t.status, t.reviewer, t.review_dato, "/viden/#" + t.id, "Tema: " + t.titel) }}</div>
      <p style="max-width:820px">{{ t.intro }}</p>

      {% if t.guide_link %}<div class="news" style="max-width:820px;margin-top:24px"><p><b>{{ t.guide_tekst }}</b></p><a class="btn terra" href="{{ t.guide_link }}">Gå til guiden</a></div>{% endif %}

      {% if t.pointer %}<div class="card tinted" style="max-width:820px;margin:28px 0 8px">
        <h3>Det vigtigste</h3>
        <ul class="check">
          {% for p in t.pointer %}<li>{{ p }}</li>
          {% endfor %}
        </ul>
      </div>{% endif %}

      {% for g in t.grupper %}
      <h3 class="kilde-gruppe">{{ g.titel }}</h3>
      <div class="grid">
        {% for k in g.kilder %}<article class="card kilde">
          {% if k.type %}<span class="ktype">{{ k.type }}</span>{% endif %}<p class="kilde-meta">{{ k.forfattere }}{% if k.aar %} · {{ k.aar }}{% endif %}{% if k.udgiver %} · {{ k.udgiver }}{% endif %}</p>
          <h4>{% if k.link %}<a href="{{ k.link }}" target="_blank" rel="noopener">{{ k.titel }}</a>{% else %}{{ k.titel }}{% endif %}</h4>
          <p>{{ k.resume }}</p>
          {% if k.link %}<a class="kilde-link" href="{{ k.link }}" target="_blank" rel="noopener">Gå til kilden</a>{% endif %}
        </article>
        {% endfor %}
      </div>
      {% endfor %}

    </div>
  </section>
{% endif %}{% endfor %}

  {% if v.note %}<section>
    <div class="wrap">
      <p class="muted">{{ v.note | escape | mail_links | safe }}</p>
    </div>
  </section>{% endif %}
