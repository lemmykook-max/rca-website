---
layout: base.njk
permalink: /kontakt/
title: Kontakt
description: "Kontakt Ressourcecenter for Adopterede (RCA). Skriv til bestyrelsen på bestyrelse@rcfa.dk."
---
{% from "ikon.njk" import ikon %}
{% set k = kontakt %}
  <div class="page-head"><div class="wrap">
    <p class="eyebrow">{{ k.eyebrow }}</p>
    <h1>{{ k.overskrift }}</h1>
    <p class="lead" style="max-width:780px">{{ k.intro }}</p>
  </div></div>
  <section>
    <div class="wrap grid g2">
      {% for c in k.kort %}<div class="card">
        {{ ikon(c.ikon, c.farve) }}
        <h3>{{ c.overskrift }}</h3>
        {% if c.email %}<p><a class="contact-mail" href="mailto:{{ c.email }}">{{ c.email }}</a></p>{% endif %}
        {% if c.tekst %}<p class="muted">{{ c.tekst }}</p>{% endif %}
        {% if c.knap_tekst %}<div class="btns" style="margin-top:8px"><a class="btn ghost" href="mailto:{{ c.email }}?subject=Medlemskab%20af%20RCA">{{ c.knap_tekst }}</a></div>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% if site.linkedin or site.facebook %}<div class="wrap" style="margin-top:28px"><div class="card tinted">
      <h3 style="margin-top:0">Følg os</h3>
      <p>Nyheder, ny viden og invitationer deler vi også her:</p>
      <div class="btns">{% if site.linkedin %}<a class="btn ghost" href="{{ site.linkedin }}">LinkedIn</a>{% endif %}{% if site.facebook %}<a class="btn ghost" href="{{ site.facebook }}">Facebook-gruppen</a>{% endif %}</div>
    </div></div>{% endif %}
  </section>
