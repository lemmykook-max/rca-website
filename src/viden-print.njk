---
permalink: /viden/print/
eleventyExcludeFromCollections: true
---
{%- from "vidensstatus.njk" import vidensstatus -%}
{%- set v = viden -%}
{%- set url = (site.url or "https://rca-website.netlify.app") + "/viden/" -%}
<!doctype html>
<html lang="da">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Viden om adoption – printversion · {{ site.undertitel }}</title>
<meta name="description" content="Printvenlig version af RCA's samling af viden om adoption. Opdateres løbende.">
<meta name="robots" content="noindex">
<link rel="stylesheet" href="/styles.css">
<style>
  body{display:block;background:#fff}
  .pv{max-width:820px;margin:0 auto;padding:32px 24px 64px}
  .pv h1{font-size:2.4rem}
  .pv h2{font-size:1.6rem;margin:0 0 .4em}
  .pv h3{font-size:1.2rem;margin:28px 0 8px}
  .pv h4{font-family:var(--serif);font-size:1.05rem;margin:0 0 .3em}
  .pv section{padding:0;border:0}
  .pv .kapitel{padding-top:40px;margin-top:40px;border-top:2px solid var(--ink)}
  .pv .prose{max-width:none}
  .pv .kilde{box-shadow:none;border:1px solid var(--line);padding:14px 16px;margin:0 0 10px}
  .pv .kilde-meta{font-size:.85rem}
  .opdateres{background:var(--terra-tint);border-left:4px solid var(--terra);border-radius:8px;padding:14px 18px;margin:20px 0}
  .opdateres b{color:var(--terra)}
  .toc ol{padding-left:34px}
  .toc li{margin:.2em 0}
  .pv-bar{position:sticky;top:0;background:#fff;border-bottom:1px solid var(--line);z-index:5}
  .pv-bar .in{max-width:820px;margin:0 auto;padding:12px 24px;display:flex;gap:12px;flex-wrap:wrap;align-items:center;justify-content:space-between}
  .forside{display:flex;flex-direction:column;gap:18px;padding:24px 0 8px}
  .forside .logo-row{display:flex;align-items:center;gap:16px}
  .forside .logo-row img{width:72px;height:72px}
  .forside .logo-row b{font-family:var(--serif);font-size:1.5rem;display:block;line-height:1.2}
  .forside .logo-row span{color:var(--muted);font-size:.95rem}
  .forside h1{font-size:3rem;margin:24px 0 4px}
  .forside .udgave{font-size:1.05rem;color:var(--ink-2)}
  .sidefod{margin-top:48px;padding-top:16px;border-top:1px solid var(--line);font-size:.9rem;color:var(--muted)}
  @media print{
    @page{size:A4;margin:16mm 16mm 20mm;
      @bottom-left{content:"Ressourcecenter for Adopterede (RCA) · {{ site.email }}";font-family:Aptos,"Segoe UI",Arial,sans-serif;font-size:8pt;color:#17424d}
      @bottom-right{content:"Udgave {{ byggedato | dato }} · opdateres løbende · side " counter(page) " af " counter(pages);font-family:Aptos,"Segoe UI",Arial,sans-serif;font-size:8pt;color:#555}
    }
    @page:first{@bottom-left{content:none}@bottom-right{content:none}}
    .forside{min-height:240mm;justify-content:space-between;break-after:page}
    .forside h1{font-size:34pt}
    body{font-size:11pt;line-height:1.45}
    .pv-bar{display:none}
    .pv{padding:0;max-width:none}
    .pv .kapitel{break-before:page;border-top:0;margin-top:0;padding-top:0}
    .pv .kilde,.opdateres,.card{break-inside:avoid}
    h2,h3,h4{break-after:avoid}
    a{color:inherit;text-decoration:none}
    .pv a[href^="http"]:not(.nourl)::after{content:" (" attr(href) ")";font-size:8pt;color:#555;word-break:break-all}
    .prose blockquote{background:none;border-left:3px solid #999}
    .vstatus-links{display:none}
    .logliste li{box-shadow:none;border:1px solid #ddd;break-inside:avoid}
    table{font-size:10pt}
  }
</style>
</head>
<body>
<div class="pv-bar"><div class="in">
  <a href="/viden/">← Tilbage til Viden</a>
  <button class="btn terra" onclick="window.print()" style="margin:0">Gem som PDF eller print</button>
</div></div>

<main class="pv">
  <div class="forside">
    <div class="logo-row"><img src="/files/signatur/rca-logo.png" alt="RCA-logo"><div><b>{{ site.undertitel }}</b><span>{{ site.tagline }}</span></div></div>
    <div>
      <p class="eyebrow">Udgivet af {{ site.navn }}</p>
      <h1>{{ v.overskrift }}</h1>
      <p class="udgave">Samlet viden, guides og forskning for adopterede, familier og fagfolk</p>
      <p class="lead">{{ v.intro }}</p>
      <div class="opdateres">
        <p style="margin:0 0 .4em"><b>Denne samling opdateres løbende.</b></p>
        <p style="margin:0">Denne udgave er fra <b>{{ byggedato | dato }}</b>. Regler, tilbud og forskning ændrer sig, så tjek altid den nyeste version på <a class="nourl" href="{{ url }}">{{ url | replace("https://", "") }}</a>, før du bruger oplysningerne. Har du rettelser, så skriv til {{ site.email }}.</p>
      </div>
    </div>
    <p class="muted" style="font-size:.9rem;margin:0">© {{ byggedato.getFullYear() }} {{ site.navn }} · {{ site.email }}. Må gerne deles og printes med kildeangivelse.{% if site.linkedin %}<br>Følg os på LinkedIn: <span class="nourl">{{ site.linkedin | replace("https://www.", "") }}</span>{% endif %}{% if site.facebook %} · Facebook: <span class="nourl">{{ site.facebook | replace("https://www.", "") }}</span>{% endif %}</p>
  </div>

  <nav class="toc" aria-label="Indhold">
    <h2>Indhold</h2>
    <ol>
      {%- for g in v.guides %}
      <li>{{ g.titel }}</li>
      {%- endfor %}
      {%- for t in v.temaer %}{% if t.klar %}
      <li>Tema: {{ t.titel }}</li>
      {%- endif %}{% endfor %}
      <li>Ændringslog</li>
    </ol>
  </nav>

  {%- for g in v.guides %}
  {%- for p in collections.vidensider %}{% if p.url == g.link %}
  <section class="kapitel">
    <p class="eyebrow">{{ p.data.eyebrow or "Guide" }}</p>
    <h2>{{ p.data.title }}</h2>
    {% if p.data.intro %}<p class="lead">{{ p.data.intro }}</p>{% endif %}
    {% if p.data.status %}{{ vidensstatus(p.data.status, p.data.reviewer, p.data.review_dato, p.url, p.data.title) }}{% endif %}
    <div class="prose">{{ p.content | safe }}</div>
  </section>
  {%- endif %}{% endfor %}
  {%- endfor %}

  {%- for t in v.temaer %}{% if t.klar %}
  <section class="kapitel">
    <p class="eyebrow">Tema</p>
    <h2>{{ t.titel }}</h2>
    {% if t.stoette %}<p class="stoette" role="note"><b>Vær opmærksom:</b> {{ t.stoette }}</p>{% endif %}
    {{ vidensstatus(t.status, t.reviewer, t.review_dato, "/viden/#" + t.id, "Tema: " + t.titel) }}
    <p>{{ t.intro }}</p>
    {% if t.pointer %}<h3>Det vigtigste</h3>
    <ul class="check">
      {% for pt in t.pointer %}<li>{{ pt }}</li>
      {% endfor %}
    </ul>{% endif %}
    {% for gr in t.grupper %}
    <h3>{{ gr.titel }}</h3>
    {% for k in gr.kilder %}<div class="card kilde">
      {% if k.kildetype %}<span class="ktype">{{ k.kildetype }}</span>{% endif %}{% if k.metode %}<span class="kmetode">{{ k.metode }}</span>{% endif %}<p class="kilde-meta">{{ k.forfattere }}{% if k.aar %} · {{ k.aar }}{% endif %}{% if k.udgiver %} · {{ k.udgiver }}{% endif %}</p>
      <h4>{% if k.link %}<a href="{{ k.link }}">{{ k.titel }}</a>{% else %}{{ k.titel }}{% endif %}</h4>
      <p style="margin:0">{{ k.resume }}</p>
    </div>
    {% endfor %}
    {% endfor %}
  </section>
  {%- endif %}{% endfor %}

  <section class="kapitel">
    <p class="eyebrow">Viden</p>
    <h2>Ændringslog</h2>
    <ul class="logliste">
      {% for p in aendringslog.poster %}<li><span class="when">{{ p.dato | dato }}</span><b>{{ p.side }}</b><br>{{ p.tekst }}</li>
      {% endfor %}
    </ul>
  </section>

  <div class="sidefod">
    <p>{{ site.navn }} · {{ site.email }} · {{ url | replace("https://", "") }}</p>
    <p>Udgave fra {{ byggedato | dato }}. Samlingen opdateres løbende – hent altid den nyeste version online.</p>
  </div>
</main>
</body>
</html>
